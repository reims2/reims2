{
  "name": "reims2-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.18.1",
  "scripts": {
    "dev": "vite",
    "dev:local": "VITE_API_URL=http://localhost:9966/ vite",
    "dev:remote": "VITE_API_URL=https://dev.reims2.app/ vite",
    "build": "vue-tsc --build && vite build",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "preview": "vite preview",
    "lint": "eslint . --fix",
    "test": "vitest run --coverage",
    "test:watch": "vitest --ui --coverage"
  },
  "engines": {
    "node": "24.22.0"
  },
  "dependencies": {
    "@fontsource-variable/roboto-flex": "5.3.0",
    "@vue/devtools-api": "8.2.1",
    "@vueuse/core": "15.0.0",
    "axios": "1.20.0",
    "dayjs": "1.11.23",
    "jwt-decode": "4.0.0",
    "pinia": "4.0.3",
    "pinia-plugin-persistedstate": "4.7.1",
    "vue": "3.5.44",
    "vue-router": "5.4.0",
    "vue3-enter-to-tab": "3.1.6",
    "vuetify": "4.2.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@mdi/js": "7.4.47",
    "@pinia/testing": "2.0.2",
    "@testing-library/vue": "8.1.0",
    "@types/eslint": "9.6.1",
    "@types/node": "24.19.2",
    "@vitejs/devtools": "0.8.0",
    "@vitejs/plugin-vue": "6.0.10",
    "@vitest/coverage-v8": "5.0.4",
    "@vitest/ui": "5.0.5",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.10.0",
    "globals": "17.13.0",
    "happy-dom": "21.0.3",
    "prettier": "3.9.6",
    "sass-embedded": "1.105.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "unplugin-auto-import": "21.1.0",
    "vite": "8.3.4",
    "vite-plugin-pwa": "2.0.0",
    "vite-plugin-vuetify": "2.1.3",
    "vitest": "5.0.4",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.13",
    "workbox-window": "7.4.1"
  },
  "resolutions": {
    "vue": "3.5.44"
  }
}
