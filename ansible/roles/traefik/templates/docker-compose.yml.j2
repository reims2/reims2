{{ ansible_managed | comment }}

services:
  traefik:
    image: traefik:v3.7.15@sha256:0f6150202bc1fed72a7bd2107460eaa510e5b8a905f3fdb5b84f2c8619c33368
    read_only: true
    restart: unless-stopped
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
      - "{{ traefik_acme_location }}:/etc/traefik/acme"
      - "{{ traefik_config_location }}:/etc/traefik/dynamic_conf:ro"
    command:
      - --entryPoints.web.address=:80
      - --entryPoints.web.http.redirections.entryPoint.to=websecure
      - --entryPoints.web.http.redirections.entryPoint.scheme=https
      - --entryPoints.web.http.redirections.entryPoint.permanent=true
      - --entryPoints.websecure.address=:443
      - --entryPoints.websecure.http.middlewares=autodetect@file,compress@file
{% if traefik_https_letsencrypt_enabled %}
      - --entryPoints.websecure.http.tls.certResolver={{ traefik_certresolver }}
      - --certificatesResolvers.{{ traefik_certresolver }}.acme.httpChallenge=true
      - --certificatesResolvers.{{ traefik_certresolver }}.acme.httpChallenge.entryPoint=web
      - --certificatesResolvers.{{ traefik_certresolver }}.acme.email={{ traefik_letsencrypt_email }}
      - --certificatesResolvers.{{ traefik_certresolver }}.acme.storage=/etc/traefik/acme/acme.json
{% else %}
      - --entryPoints.websecure.http.tls=true
{% endif %}
      - --accesslog={{ traefik_access_log_enabled | bool | lower }}
      - --providers.file.directory=/etc/traefik/dynamic_conf
      - --providers.file.watch=true
      - --providers.docker=true
      - --providers.docker.exposedByDefault=false
      - --providers.docker.network={{ proxy_network }}
    deploy:
      resources:
        limits:
          cpus: "1"
          memory: 256M
    networks:
      - proxy

networks:
  proxy:
    name: "{{ proxy_network }}"
    external: true
