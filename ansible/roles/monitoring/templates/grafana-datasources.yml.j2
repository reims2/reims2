{{ ansible_managed | comment }}

apiVersion: 1

datasources:
  - name: Prometheus
    type: prometheus
    uid: prometheus_reims
    access: proxy
    url: "http://prometheus:9090"
    editable: true
  - name: REIMS production DB
    type: mysql
    uid: mariadb_reims
    access: proxy
    url: "mariadb:{{db_port}}"
    editable: true
    database: {{reims2_db_name}}
    user: monitoring
    secureJsonData:
        password: {{monitoring_db_password}}
    jsonData:
        maxOpenConns: 10
        timeInterval: "15s"
