      "targets": [
        {
          "dataset": "reims2_db",
          "datasource": {
            "type": "mysql",
            "uid": "mariadb_reims"
          },
          "editorMode": "code",
          "format": "table",
          "hide": false,
          "rawQuery": true,
          "rawSql": "SELECT\n  dispensed.sphere as sphere,\n  ((dispensed_percentage - inventory_percentage) / SUM(dispensed_percentage - inventory_percentage) OVER ()) * 100 as diff\nFROM\n  (\n    SELECT FLOOR(od_sphere) as sphere, (COUNT(*) / CAST(SUM(COUNT(*)) OVER () as float) * 100) as inventory_percentage\n    FROM stats_glasses\n    WHERE status = 'in_stock'\n      AND location LIKE '$location'\n      AND glasses_type LIKE $glasses_type\n    GROUP BY FLOOR(od_sphere)\n  ) as inventory\n  LEFT JOIN (\n    SELECT FLOOR(od_sphere) as sphere, (COUNT(*) / CAST(SUM(COUNT(*)) OVER () as float) * 100) as dispensed_percentage\n    FROM stats_glasses\n    WHERE status = 'dispensed'\n      AND location LIKE '$location'\n      AND glasses_type LIKE $glasses_type\n    GROUP BY FLOOR(od_sphere)\n  ) as dispensed ON inventory.sphere = dispensed.sphere\nWHERE\n  abs(dispensed.sphere) <= 4\n  AND (dispensed_percentage - inventory_percentage) > 0.5\nORDER BY\n  dispensed.sphere",
          "refId": "V",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
