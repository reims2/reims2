{{ ansible_managed | comment }}

services:
  backup:
    image: offen/docker-volume-backup:v2.49.3@sha256:570a4bea8c19f824b22a4ce31e01afdf418a7bb616dcb17052f0a78b504ac54c
    restart: unless-stopped
    environment:
      BACKUP_CRON_EXPRESSION: "0 */6 * * *"
      # sorts together with the older dokku/s3backup uploads, restore.sh picks the last one
      BACKUP_FILENAME: reims2-backup-%Y-%m-%d-%H-%M-%S.tgz
      AWS_S3_BUCKET_NAME: "{{ s3backup_bucket_name }}"
      AWS_ACCESS_KEY_ID: "{{ aws_key_id }}"
      AWS_SECRET_ACCESS_KEY: "{{ aws_secret_key }}"
      EXEC_FORWARD_OUTPUT: "true"
      # grafana downloads its plugins again by itself, only grafana.db matters
      BACKUP_EXCLUDE_REGEXP: "^/backup/grafana/plugins"
{% if s3backup_healthcheck_url %}
      NOTIFICATION_URLS: "{{ s3backup_healthcheck_url }}"
      NOTIFICATION_LEVEL: info
{% endif %}
    volumes:
      # the mariadb archive-pre label in compose.prod.yaml writes dump.sql here
      - "{{ s3backup_install_location }}/dump:/backup/db:ro"
      - "{{ s3backup_grafana_data_location }}:/backup/grafana:ro"
      - /var/run/docker.sock:/var/run/docker.sock:ro
