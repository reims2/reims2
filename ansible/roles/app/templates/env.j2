{{ ansible_managed | comment }}
# Read by docker compose, so plain `docker compose ps/logs/exec` works in this directory
COMPOSE_PROJECT_NAME={{ stack }}
COMPOSE_FILE=compose.yaml:compose.server.yaml:compose.{{ stack }}.yaml
STACK={{ stack }}
TAG={{ app_env_tag }}
APP_DOMAIN={{ app_domain }}
PROXY_NETWORK={{ proxy_network }}
INNODB_BUFFER_POOL_SIZE={{ app_innodb_buffer_pool_size }}
DATABASE_NAME={{ reims2_db_name }}
DATABASE_USER={{ reims2_db_user }}
DATABASE_PASSWORD='{{ reims2_db_password }}'
DATABASE_ROOT_PASSWORD='{{ reims2_db_root_password }}'
JWT_SECRET='{{ reims2_jwt_secret }}'
