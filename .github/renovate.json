{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":prHourlyLimitNone",
    ":separateMajorReleases",
    "helpers:pinGitHubActionDigests",
    "docker:pinDigests",
    ":automergePr",
    ":prConcurrentLimit10"
  ],
  "automergeSchedule": [
    "* * * * 6"
  ],
  "configMigration": true,
  "minimumReleaseAge": "7 days",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "labels": [
    "dependencies"
  ],
  "automerge": true,
  "platformAutomerge": true,
  "assignees": [
    "l3d00m"
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "* 0-13 1 * *"
    ]
  },
  "osvVulnerabilityAlerts": true,
  "postUpdateOptions": [
    "pnpmDedupe"
  ],
  "packageRules": [
    {
      "description": "Everything that ships to prod, monthly",
      "groupName": "all non-major dependencies",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "pinDigest",
        "digest"
      ]
    },
    {
      "description": "On its own, the Visual check stops it when screenshots change",
      "groupName": "vuetify",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "pinDigest",
        "digest"
      ],
      "matchPackageNames": [
        "vuetify"
      ]
    },
    {
      "description": "Only runs in CI or builds, so every three months",
      "groupName": "toolchain",
      "extends": [
        "schedule:quarterly"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "pinDigest",
        "digest"
      ],
      "matchPackageNames": [
        "node",
        "@types/node",
        "pnpm",
        "corepack",
        "maven",
        "maven-wrapper"
      ]
    },
    {
      "groupName": "toolchain",
      "extends": [
        "schedule:quarterly"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "pinDigest",
        "digest"
      ],
      "matchManagers": [
        "github-actions"
      ]
    },
    {
      "description": "Break most often, so apart from everything else",
      "groupName": "linters",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "pinDigest",
        "digest"
      ],
      "extends": [
        "packages:linters",
        "schedule:quarterly"
      ],
      "matchPackageNames": [
        "typescript",
        "vue-tsc",
        "vue-eslint-parser",
        "globals",
        "ansible/ansible-lint"
      ]
    },
    {
      "groupName": "test packages",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "pinDigest",
        "digest"
      ],
      "extends": [
        "packages:test",
        "schedule:quarterly"
      ],
      "matchPackageNames": [
        "happy-dom",
        "@pinia/testing",
        "@playwright/test",
        "@axe-core/playwright"
      ]
    },
    {
      "description": "Majors get a PR each, so closing one keeps that major away. Monorepos still come together.",
      "matchUpdateTypes": [
        "major"
      ],
      "minimumReleaseAge": "30 days"
    },
    {
      "description": "MariaDB converts prod's data files and CI never runs the Galaxy roles",
      "matchUpdateTypes": [
        "major"
      ],
      "matchPackageNames": [
        "mariadb"
      ],
      "automerge": false
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "matchManagers": [
        "ansible-galaxy"
      ],
      "automerge": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)Dockerfile$/",
        "/^.github/.+/*\\.ya?ml$/",
        "/defaults/main.ya?ml$/"
      ],
      "matchStrings": [
        "renovate:? datasource=(?<datasource>.*?) depName=(?<depName>.*?)( versioning=(?<versioning>.*?))?\\s.*?_(?:VERSION|version)[=:] ?(?<currentValue>.*)\\s"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}"
    }
  ],
  "ansible": {
    "managerFilePatterns": [
      "/(^|/)tasks/[^/]+\\.ya?ml$/",
      "/docker-compose\\.ya?ml(\\.j2)?$/"
    ]
  },
  "ignoreDeps": [
    "ghcr.io/reims2/reims2-frontend",
    "ghcr.io/reims2/reims2-backend",
    "ghcr.io/reims2/reims2-docs"
  ],
  "schedule": [
    "* 0-13 1 * *"
  ],
  "timezone": "Europe/Berlin",
  "npm": {
    "extends": [
      ":pinAllExceptPeerDependencies"
    ]
  }
}
